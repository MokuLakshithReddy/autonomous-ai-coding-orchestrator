FROM node:22-bookworm-slim

# Install system dependencies & Git
RUN apt-get update && \
    apt-get install -y --no-install-recommends git curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install Anthropic Claude Code CLI
RUN npm install -g @anthropic-ai/claude-code

# Create non-root unprivileged workspace user matching orchestrator container user
RUN useradd -u 1000 -m orchestrator && \
    mkdir -p /workspace && \
    chown -R orchestrator:orchestrator /workspace

USER orchestrator
WORKDIR /workspace

ENTRYPOINT ["claude"]

